# ====================================================================
# .gitignore for Saree & Textile E-Commerce Platform (.NET + Angular)
# ====================================================================

# --------------------------------------------------
# .NET / Visual Studio Build & Tooling
# --------------------------------------------------
bin/
obj/
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates
.vs/
.dotnet/
TestResults/
*.trx
*.coverage
*.coveragexml

# --------------------------------------------------
# Node.js & Angular
# --------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.angular/
dist/
tmp/
out-tsc/
.vite/

# --------------------------------------------------
# Environment, Credentials & Local Secrets
# --------------------------------------------------
*.env
*.env.*
!*.env.example
appsettings.Production.json
appsettings.*.local.json
secrets.json

# --------------------------------------------------
# Local Databases & Backups
# --------------------------------------------------
*.mdf
*.ldf
*.ndf
*.sqlite
*.sqlite3
*.db
*.bak

# --------------------------------------------------
# OS & Editor Metadata
# --------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
*.swp
*~
/docs
.gitkeep